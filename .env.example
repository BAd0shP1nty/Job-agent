# Copy to .env and fill in. Never commit .env.

# --- Anthropic (Claude Sonnet) ---
ANTHROPIC_API_KEY=
CLAUDE_MODEL=claude-sonnet-5
# Resume text is only sent to Claude when this is true (can also be toggled in the GUI).
ALLOW_RESUME_TO_LLM=false

# --- Storage ---
JOBHUNT_DB_PATH=data/jobhunt.db
JOBHUNT_DATA_DIR=data

# --- Retrieval ---
# "hashing" = local, dependency-free embeddings (default)
# "sentence-transformers" = requires `pip install sentence-transformers`
EMBEDDING_BACKEND=hashing
EMBEDDING_MODEL=all-MiniLM-L6-v2
# Optional ChromaDB persistence (requires `pip install chromadb`)
USE_CHROMA=false

# --- Optional job-source credentials ---
ADZUNA_APP_ID=
ADZUNA_APP_KEY=

# --- HTTP ---
HTTP_USER_AGENT=AutopilotJobHunt/1.0 (personal job search assistant)
HTTP_TIMEOUT_SECONDS=20
